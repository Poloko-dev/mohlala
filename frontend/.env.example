# Copy to .env.local to override.
# Where the dev server forwards /api (the FastAPI backend)
API_PROXY_TARGET=http://127.0.0.1:8000
# Base URL of the API for a production build served from another origin; empty = same origin
VITE_API_BASE_URL=
# Map tiles (default: tile.openstreetmap.org, fine for development; use your own provider in production)
VITE_TILE_URL=
VITE_TILE_ATTRIBUTION=
